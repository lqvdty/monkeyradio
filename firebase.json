{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "predeploy": [
      "node scripts/build-app.mjs",
      "node scripts/build-show-pages.mjs"
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "**/*.zip",
      "_archive/**",
      ".github/**",
      "scripts/**",
      "src/**",
      "package.json",
      "package-lock.json",
      "serve.py",
      "vercel.json",
      "README.md"
    ],
    "rewrites": [
      { "source": "/", "destination": "/index.html" },
      { "source": "/archive", "destination": "/index.html" },
      { "source": "/selectors", "destination": "/index.html" },
      { "source": "/saved", "destination": "/index.html" },
      { "source": "/ambient", "destination": "/index.html" },
      { "source": "/about", "destination": "/index.html" },
      { "source": "/legal", "destination": "/index.html" },
      { "source": "/show/**", "destination": "/index.html" }
    ]
  }
}
